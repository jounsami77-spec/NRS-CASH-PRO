{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nrs-cash-pro-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nrs-cash-pro-sync-db",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID"
    }
  ]
}
