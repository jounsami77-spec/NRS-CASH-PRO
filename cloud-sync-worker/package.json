{
  "name": "nrs-cash-pro-cloud-sync",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "check": "node --check src/index.js && node --test",
    "db:create": "wrangler d1 create nrs-cash-pro-sync-db",
    "db:apply": "wrangler d1 execute nrs-cash-pro-sync-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
